MONGODB_URI=mongodb://127.0.0.1:27017/guitar-notes
# Optional: overrides the database in the connection string.
# MONGODB_DB_NAME=guitar-notes
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional: enables the Google button after restarting/rebuilding.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
